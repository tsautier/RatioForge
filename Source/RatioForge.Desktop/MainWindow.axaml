<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RatioForge.Desktop.MainWindow"
        Title="RatioForge"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="64,*,34">
    <Border Grid.Row="0" Background="#151A1F" BorderBrush="#2C343D" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="RatioForge" FontSize="21" FontWeight="Bold" Foreground="#F4F7F8" />
          <TextBlock Text="Tracker session console" FontSize="11" Foreground="#84909B" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Help" Padding="12,7">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="GitHub repository" Click="Repository_Click" />
                <MenuItem Header="Create an issue" Click="CreateIssue_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Content="Settings" Click="Settings_Click" Padding="12,7" />
          <Border CornerRadius="4" Background="#20332F" Padding="9,5" VerticalAlignment="Center">
            <TextBlock x:Name="PlatformText" Foreground="#66D5BE" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="420,*" Margin="20" ColumnSpacing="16">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="section-title" Text="Torrent" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="TorrentPathBox" PlaceholderText="Choose a .torrent file" IsReadOnly="True" />
                <Button Grid.Column="1" Content="Open..." Click="OpenTorrent_Click" Padding="14,8" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Classes="label" Text="Name" />
                  <TextBlock x:Name="TorrentNameText" Text="No torrent loaded" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Size" />
                  <TextBlock x:Name="TorrentSizeText" Text="-" />
                </StackPanel>
              </Grid>
              <StackPanel>
                <TextBlock Classes="label" Text="Tracker" />
                <TextBlock x:Name="TrackerText" Text="-" TextWrapping="Wrap" MaxHeight="48" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Torrent info hash" />
                <TextBox x:Name="InfoHashBox" Text="-" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,monospace" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="section-title" Text="Identity and network" />
              <TextBlock Classes="label" Text="Emulated client" />
              <ComboBox x:Name="ClientCombo" SelectionChanged="ClientCombo_SelectionChanged" />
              <TextBlock x:Name="UserAgentText" FontSize="11" Foreground="#7F8B95" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Client key" />
                  <TextBox x:Name="ClientKeyBox" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,monospace" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Peer ID" />
                  <TextBox x:Name="PeerIdBox" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,monospace" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="label" Text="Local network address" />
              <ComboBox x:Name="AddressCombo" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Local IPv4" />
                  <TextBox x:Name="LocalIpv4Box" IsReadOnly="True" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Local IPv6" />
                  <TextBox x:Name="LocalIpv6Box" IsReadOnly="True" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Port" />
                  <NumericUpDown x:Name="PortBox" Minimum="1" Maximum="65535" Value="6881" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Peers requested" />
                  <NumericUpDown x:Name="PeerCountBox" Minimum="0" Maximum="500" Value="200" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Upload KiB/s" />
                  <NumericUpDown x:Name="UploadRateBox" Minimum="0" Maximum="1048576" Value="60" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Download KiB/s" />
                  <NumericUpDown x:Name="DownloadRateBox" Minimum="0" Maximum="1048576" Value="30" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Completed %" />
                  <NumericUpDown x:Name="CompletedBox" Minimum="0" Maximum="100" Value="0" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Interval seconds" />
                  <NumericUpDown x:Name="IntervalBox" Minimum="30" Maximum="86400" Value="1800" Increment="30" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Classes="panel">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
            <StackPanel>
              <TextBlock Classes="label" Text="UPLOADED" />
              <TextBlock x:Name="UploadedText" Text="0 B" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="label" Text="DOWNLOADED" />
              <TextBlock x:Name="DownloadedText" Text="0 B" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="NEXT ANNOUNCE" />
              <TextBlock x:Name="CountdownText" Text="-" FontSize="24" FontWeight="SemiBold" Foreground="#66D5BE" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
          <Button x:Name="StartButton" Classes="primary" Content="Start session" Click="Start_Click" />
          <Button x:Name="StopButton" Grid.Column="1" Classes="danger" Content="Stop" Click="Stop_Click" IsEnabled="False" />
          <TextBlock x:Name="StatusText" Grid.Column="2" Text="Ready" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#AAB4BD" />
        </Grid>

        <Border Grid.Row="2" Classes="panel" Padding="0">
          <Grid RowDefinitions="46,*">
            <Border BorderBrush="#2C343D" BorderThickness="0,0,0,1" Padding="16,0">
              <TextBlock Classes="section-title" Text="Activity" VerticalAlignment="Center" />
            </Border>
            <ListBox x:Name="ActivityList" Grid.Row="1" Margin="8" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="#151A1F" BorderBrush="#2C343D" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="No payload data is transferred" FontSize="11" Foreground="#77838E" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11" Foreground="#77838E" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
