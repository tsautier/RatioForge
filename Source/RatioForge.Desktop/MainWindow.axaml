<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:RatioForge.Desktop"
        x:Class="RatioForge.Desktop.MainWindow"
        Title="RatioForge"
        Width="1080" Height="720"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="64,*,34">
    <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="RatioForge" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
          <TextBlock Text="Tracker session console" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="Help" Padding="12,7">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="GitHub repository" Click="Repository_Click" />
                <MenuItem Header="Create an issue" Click="CreateIssue_Click" />
                <MenuItem Header="Check for updates" Click="CheckForUpdates_Click" />
                <MenuItem Header="Network diagnostics" Click="NetworkDiagnostics_Click" />
                <MenuItem Header="Latest release" Click="LatestRelease_Click" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click" Padding="12,7" />
          <Button x:Name="UpdateButton" Content="Update available" Click="LatestRelease_Click" IsVisible="False" Padding="10,7" />
          <Border CornerRadius="4" Background="{DynamicResource PlatformBackgroundBrush}" Padding="9,5" VerticalAlignment="Center">
            <TextBlock x:Name="PlatformText" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="420,*" Margin="20" ColumnSpacing="16">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14">
          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="section-title" Text="Torrent" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="TorrentPathBox" PlaceholderText="Choose a .torrent file" IsReadOnly="True" />
                <Button x:Name="OpenTorrentButton" Grid.Column="1" Content="Open..." Click="OpenTorrent_Click" Padding="14,8" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Classes="label" Text="Name" />
                  <TextBlock x:Name="TorrentNameText" Text="No torrent loaded" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Size" />
                  <TextBlock x:Name="TorrentSizeText" Text="-" />
                </StackPanel>
              </Grid>
              <StackPanel>
                <TextBlock Classes="label" Text="Tracker" />
                <TextBlock x:Name="TrackerText" Text="-" TextWrapping="Wrap" MaxHeight="48" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                  <ComboBox x:Name="TrackerCombo" SelectionChanged="TrackerCombo_SelectionChanged" IsEnabled="False" />
                  <Button x:Name="RetryTrackerButton" Grid.Column="1" Content="Retry" Click="RetryTracker_Click" IsEnabled="False" Padding="12,7" />
                </Grid>
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="label" Text="Torrent info hash" />
                <TextBox x:Name="InfoHashBox" Text="-" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,monospace" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="section-title" Text="Identity and network" />
              <TextBlock Classes="label" Text="Emulated client" />
              <ComboBox x:Name="ClientCombo" SelectionChanged="ClientCombo_SelectionChanged" />
              <TextBlock x:Name="UserAgentText" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Client key" />
                  <TextBox x:Name="ClientKeyBox" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,monospace" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Peer ID" />
                  <TextBox x:Name="PeerIdBox" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas,monospace" />
                </StackPanel>
              </Grid>
              <TextBlock Classes="label" Text="Local network address" />
              <ComboBox x:Name="AddressCombo" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Local IPv4" />
                  <TextBox x:Name="LocalIpv4Box" IsReadOnly="True" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Local IPv6" />
                  <TextBox x:Name="LocalIpv6Box" IsReadOnly="True" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Port" />
                  <NumericUpDown x:Name="PortBox" Minimum="1" Maximum="65535" Value="6881" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Peers requested" />
                  <NumericUpDown x:Name="PeerCountBox" Minimum="0" Maximum="500" Value="200" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Upload KiB/s" />
                  <NumericUpDown x:Name="UploadRateBox" Minimum="0" Maximum="1048576" Value="60" FormatString="0" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Download KiB/s" />
                  <NumericUpDown x:Name="DownloadRateBox" Minimum="0" Maximum="1048576" Value="30" FormatString="0" Increment="1" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Completed %" />
                  <NumericUpDown x:Name="CompletedBox" Minimum="0" Maximum="100" Value="0" Increment="1" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Interval seconds" />
                  <NumericUpDown x:Name="IntervalBox" Minimum="30" Maximum="86400" Value="1800" Increment="30" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Border Classes="panel">
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
            <StackPanel>
              <TextBlock Classes="label" Text="UPLOADED" />
              <TextBlock x:Name="UploadedText" Text="0 B" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="RatioText" Text="Ratio -" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="label" Text="DOWNLOADED" />
              <TextBlock x:Name="DownloadedText" Text="0 B" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="CompletionText" Text="Completed 0%" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="label" Text="NEXT ANNOUNCE" />
              <TextBlock x:Name="CountdownText" Text="-" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
              <TextBlock x:Name="ElapsedText" Text="Elapsed 00:00:00" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="8">
          <WrapPanel Orientation="Horizontal">
            <Button x:Name="StartButton" Classes="primary" Content="Start session" Click="Start_Click" Margin="0,0,10,0" />
            <Button x:Name="StopButton" Classes="danger" Content="Stop" Click="Stop_Click" IsEnabled="False" Margin="0,0,10,0" />
            <Button x:Name="ManualUpdateButton" Content="Manual update" Click="ManualUpdate_Click" IsEnabled="False" Margin="0,0,10,0" />
            <Button x:Name="ResetSessionButton" Content="Reset" Click="ResetSession_Click" IsEnabled="False" Margin="0,0,10,0" />
            <Button x:Name="NetworkDiagnosticsButton" Content="Network check" Click="NetworkDiagnostics_Click" />
          </WrapPanel>
          <TextBlock x:Name="StatusText" Grid.Row="1" Text="Ready" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Grid>

        <Border Grid.Row="2" Classes="panel" Padding="0">
          <Grid RowDefinitions="46,*">
            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="section-title" Text="Session records" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Button Content="Open log" Click="OpenDebugLog_Click" Padding="9,5" />
                  <Button Content="Copy diagnostics" Click="CopyDiagnostics_Click" Padding="9,5" />
                  <Button Content="Clear" Click="ClearActivity_Click" Padding="9,5" />
                </StackPanel>
              </Grid>
            </Border>
            <TabControl Grid.Row="1" Margin="8">
              <TabItem Header="Activity">
                <ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
              </TabItem>
              <TabItem Header="Announces">
                <Grid RowDefinitions="Auto,34,*">
                  <Grid ColumnDefinitions="Auto,150,150,150,*,Auto,Auto" ColumnSpacing="8" Margin="8,4,8,8">
                    <TextBlock Text="Filter" Classes="label" VerticalAlignment="Center" />
                    <ComboBox x:Name="HistoryEventFilter" Grid.Column="1" SelectionChanged="HistoryFilter_SelectionChanged" />
                    <ComboBox x:Name="HistoryProtocolFilter" Grid.Column="2" SelectionChanged="HistoryFilter_SelectionChanged" />
                    <ComboBox x:Name="HistoryStatusFilter" Grid.Column="3" SelectionChanged="HistoryFilter_SelectionChanged" />
                    <Button Grid.Column="5" Content="CSV" Click="ExportHistoryCsv_Click" Padding="10,5" />
                    <Button Grid.Column="6" Content="JSON" Click="ExportHistoryJson_Click" Padding="10,5" />
                  </Grid>
                  <Grid Grid.Row="1" ColumnDefinitions="70,75,*,65,55,65,65,120" ColumnSpacing="8" Margin="8,0">
                    <TextBlock Text="Time" Classes="label" />
                    <TextBlock Grid.Column="1" Text="Event" Classes="label" />
                    <TextBlock Grid.Column="2" Text="Tracker" Classes="label" />
                    <TextBlock Grid.Column="3" Text="Protocol" Classes="label" />
                    <TextBlock Grid.Column="4" Text="Status" Classes="label" />
                    <TextBlock Grid.Column="5" Text="Latency" Classes="label" />
                    <TextBlock Grid.Column="6" Text="Interval" Classes="label" />
                    <TextBlock Grid.Column="7" Text="Result" Classes="label" />
                  </Grid>
                  <ListBox x:Name="AnnounceHistoryList" Grid.Row="2" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="local:AnnounceHistoryRow">
                        <Grid ColumnDefinitions="70,75,*,65,55,65,65,120" ColumnSpacing="8" Margin="8,5">
                          <TextBlock Text="{Binding Time}" />
                          <TextBlock Grid.Column="1" Text="{Binding Event}" />
                          <TextBlock Grid.Column="2" Text="{Binding Tracker}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="3" Text="{Binding Protocol}" />
                          <TextBlock Grid.Column="4" Text="{Binding Status}" />
                          <TextBlock Grid.Column="5" Text="{Binding Latency}" />
                          <TextBlock Grid.Column="6" Text="{Binding Interval}" />
                          <TextBlock Grid.Column="7" Text="{Binding Result}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource ChromeBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="No payload data is transferred" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
