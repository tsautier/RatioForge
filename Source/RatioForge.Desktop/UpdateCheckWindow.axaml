<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RatioForge.Desktop.UpdateCheckWindow"
        Title="RatioForge Update"
        Width="620" Height="440"
        MinWidth="480" MinHeight="320"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <Grid Margin="24" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <TextBlock x:Name="DialogTitleText" Classes="section-title" FontSize="18" />
      <TextBlock x:Name="DialogMessageText" Grid.Row="1" TextWrapping="Wrap" />
      <TextBox x:Name="ReleaseNotesText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="OpenReleaseButton" Content="Open release" Click="OpenRelease_Click" Padding="14,8" />
        <Button x:Name="DownloadButton" Classes="primary" Content="Download verified update" Click="Download_Click" Padding="14,8" />
        <Button Classes="primary" Content="OK" Click="Close_Click" Padding="18,8" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
