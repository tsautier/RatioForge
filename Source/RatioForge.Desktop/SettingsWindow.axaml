<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RatioForge.Desktop.SettingsWindow"
        Title="RatioForge Settings"
        Width="640" Height="690"
        MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <Grid RowDefinitions="*,Auto">
    <TabControl Margin="18">
      <TabItem Header="General">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="12">
            <TextBlock Classes="section-title" Text="Session defaults" />
            <TextBlock Classes="label" Text="Appearance" />
            <ComboBox x:Name="ThemeModeCombo" />
            <TextBlock Classes="label" Text="Emulated client" />
            <ComboBox x:Name="ProfileCombo" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Classes="label" Text="Upload KiB/s" />
                <NumericUpDown x:Name="UploadRateBox" Minimum="0" Maximum="1048576" FormatString="0" Increment="1" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Download KiB/s" />
                <NumericUpDown x:Name="DownloadRateBox" Minimum="0" Maximum="1048576" FormatString="0" Increment="1" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Classes="label" Text="Announce interval seconds" />
                <NumericUpDown x:Name="IntervalBox" Minimum="30" Maximum="86400" Increment="30" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Peers requested" />
                <NumericUpDown x:Name="PeerCountBox" Minimum="0" Maximum="500" />
              </StackPanel>
            </Grid>
            <CheckBox x:Name="ActivityLogCheck" Content="Enable activity log" />
            <CheckBox x:Name="DebugLogCheck" Content="Enable persistent debug logging" />
            <CheckBox x:Name="StopOnTrackerFailureCheck" Content="Stop when the tracker rejects an announce" />
            <CheckBox x:Name="PauseUploadWhenNoLeechersCheck" Content="Pause upload while the tracker reports no leechers" />
            <TextBlock Classes="label" Text="Automatic stop" />
            <Grid ColumnDefinitions="*,180" ColumnSpacing="12">
              <ComboBox x:Name="StopConditionCombo" SelectionChanged="StopConditionCombo_SelectionChanged" />
              <StackPanel Grid.Column="1">
                <TextBlock x:Name="StopValueLabel" Classes="label" Text="Value" />
                <NumericUpDown x:Name="StopValueBox" Minimum="1" Maximum="1048576" FormatString="0.##" Increment="1" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="Debug log file" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox x:Name="DebugLogPathBox" IsReadOnly="True" />
              <Button Grid.Column="1" Content="Open log" Click="OpenDebugLog_Click" Padding="12,7" />
            </Grid>
            <TextBlock Classes="label" Text="Custom client catalog" />
            <TextBox x:Name="ClientCatalogPathBox" IsReadOnly="True" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Network">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="12">
            <TextBlock Classes="section-title" Text="Listener and source address" />
            <TextBlock Classes="label" Text="Local IPv4 / IPv6 address" />
            <ComboBox x:Name="AddressCombo" />
            <TextBlock Classes="label" Text="Listening port" />
            <NumericUpDown x:Name="PortBox" Minimum="1" Maximum="65535" />
            <Separator Margin="0,8" />
            <TextBlock Classes="section-title" Text="Tracker proxy" />
            <TextBlock Classes="label" Text="Proxy mode" />
            <ComboBox x:Name="ProxyModeCombo" SelectionChanged="ProxyModeCombo_SelectionChanged" />
            <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Classes="label" Text="Host" />
                <TextBox x:Name="ProxyHostBox" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Port" />
                <NumericUpDown x:Name="ProxyPortBox" Minimum="1" Maximum="65535" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="label" Text="Username" />
            <TextBox x:Name="ProxyUsernameBox" />
            <TextBlock Classes="label" Text="Password (session only)" />
            <TextBox x:Name="ProxyPasswordBox" PasswordChar="*" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Randomization">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="12">
            <TextBlock Classes="section-title" Text="Upload rate" />
            <CheckBox x:Name="RandomUploadCheck" Content="Randomize when a session starts" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Classes="label" Text="Minimum KiB/s" />
                <NumericUpDown x:Name="MinimumUploadBox" Minimum="0" Maximum="1048576" FormatString="0" Increment="1" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Maximum KiB/s" />
                <NumericUpDown x:Name="MaximumUploadBox" Minimum="0" Maximum="1048576" FormatString="0" Increment="1" />
              </StackPanel>
            </Grid>
            <Separator Margin="0,8" />
            <TextBlock Classes="section-title" Text="Download rate" />
            <CheckBox x:Name="RandomDownloadCheck" Content="Randomize when a session starts" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Classes="label" Text="Minimum KiB/s" />
                <NumericUpDown x:Name="MinimumDownloadBox" Minimum="0" Maximum="1048576" FormatString="0" Increment="1" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Classes="label" Text="Maximum KiB/s" />
                <NumericUpDown x:Name="MaximumDownloadBox" Minimum="0" Maximum="1048576" FormatString="0" Increment="1" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Profiles">
        <Grid Margin="8,18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="section-title" Text="Named session profiles" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Profiles contain client, rates, port, proxy, address, and randomization settings." TextWrapping="Wrap" />
          </StackPanel>
          <ListBox x:Name="SessionProfilesList" Grid.Row="1" />
          <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBox x:Name="SessionProfileNameBox" PlaceholderText="Profile name" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Load selected" Click="LoadProfile_Click" Padding="12,7" />
              <Button Content="Save current as" Click="SaveProfile_Click" Padding="12,7" />
              <Button Content="Delete" Click="DeleteProfile_Click" Padding="12,7" />
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ImportSessionProfilesButton" Content="Import sessions" Click="ImportSessionProfiles_Click" Padding="12,7" />
              <Button x:Name="ExportSessionProfilesButton" Content="Export sessions" Click="ExportSessionProfiles_Click" Padding="12,7" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="ImportClientProfilesButton" Content="Import clients" Click="ImportClientProfiles_Click" Padding="12,7" />
              <Button x:Name="ExportClientProfilesButton" Content="Export clients" Click="ExportClientProfiles_Click" Padding="12,7" />
              <TextBlock Text="Client imports apply immediately." Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel>
          <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
          <TextBlock x:Name="NoticeText" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Defaults" Click="ResetDefaults_Click" Padding="16,8" />
          <Button Content="Cancel" Click="Cancel_Click" Padding="16,8" />
          <Button x:Name="SaveButton" Classes="primary" Content="Save settings" Click="Save_Click" Padding="16,8" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
