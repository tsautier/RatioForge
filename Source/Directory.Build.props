<Project>
  <PropertyGroup>
    <RatioForgeVersion>1.2.4</RatioForgeVersion>
    <Version>$(RatioForgeVersion)</Version>
    <VersionPrefix>$(RatioForgeVersion)</VersionPrefix>
    <AssemblyVersion>$(RatioForgeVersion).0</AssemblyVersion>
    <FileVersion>$(RatioForgeVersion).0</FileVersion>
    <InformationalVersion>$(RatioForgeVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/tsautier/RatioForge</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>
</Project>
