<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RatioForge</RootNamespace>
    <AssemblyName>RatioForge.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Description>Portable torrent parsing and tracker announce engine for RatioForge</Description>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8600;CS8603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="clients.json" LogicalName="RatioForge.clients.json" />
  </ItemGroup>
</Project>
